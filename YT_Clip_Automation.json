    {
      "parameters": {
        "jsCode": "const geminiText = $input.first().json.candidates[0].content.parts[0].text;\n\n// no regex needed — Gemini returns clean array now\nconst ideas = JSON.parse(geminiText.trim());\n\nfunction parseTimestamp(tsString) {\n  const clean = tsString.replace(/\\s/g, \"\");\n  const [start, end] = clean.split(\"-\");\n  return { start, end };\n}\n\nconst clips = ideas.map((idea) => {\n  const { start, end } = parseTimestamp(idea.timestamps);\n  return {\n    title: idea.hook_title\n      .toLowerCase()\n      .replace(/[^a-z0-9]+/g, \"_\")\n      .slice(0, 40),\n    start,\n    end,\n    hook: idea.hook_title,\n  };\n});\n\nreturn clips.map((clip) => ({ json: clip }));"
      },
