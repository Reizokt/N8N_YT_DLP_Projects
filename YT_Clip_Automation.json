        "jsCode": "const rawClips = $input.all().map(item => item.json);\nconst downloadJobId =$('HTTP POST Uvicorn').first().json.job_id ; // adjust node name if needed\n\nconst clips = rawClips.map(clip => ({\n  title: clip.title,   // already processed\n  start: clip.start,   // already split\n  end: clip.end\n}));\n\nreturn [{\n  json: {\n    download_job_id: downloadJobId,\n    clips\n  }\n}];"
      },
